# Interface and port the gateway binds to (default 127.0.0.1:8080).
# Keep it on loopback: POST /send impersonates the paired WhatsApp account.
HOST=127.0.0.1
PORT=8001

# Shared secret required on POST /send as "Authorization: Bearer <token>".
# Must match WHATSAPP_BOT_TOKEN in backend/code/.env. The gateway refuses to
# start without it. Regenerate with: openssl rand -hex 32
WHATSAPP_BOT_TOKEN=127655b2e465613046a56c655d80815d0ff4121c87ad4b68fb2742f1e525dacf

# Name the phone shows for this linked device (default travel-safe). WhatsApp rejects
# presence updates without a push name, so the account would look offline; an existing
# session stored without one is given this name on the next start.
PUSH_NAME=travel-safe

