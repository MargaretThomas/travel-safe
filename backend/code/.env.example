# Optional Supabase Postgres connection string
DATABASE_URL=

# Comma-separated Expo web development and deployed preview origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://your-expo-web-preview.example.com

# Optional absolute path to DataFirst SAPS annual crime CSV (Version 1.4).
# If omitted, backend/data/sapacr-2005-2026-v1_4.csv is used.
SAPS_CRIME_CSV_PATH=

# Optional curated local-known-spots JSON.
# If omitted, backend/data/golden-spots.json is used.
GOLDEN_SPOTS_JSON_PATH=
