# Optional Supabase Postgres connection string
DATABASE_URL=

# Comma-separated Expo web development and deployed preview origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://your-expo-web-preview.example.com

# Optional absolute path to the full DataFirst SAPS annual crime CSV (Version 1.4).
# When omitted, the backend uses the checked-in validated 2025/2026 snapshot.
SAPS_CRIME_CSV_PATH=
